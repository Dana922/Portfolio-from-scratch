---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Dana Forough Dabagh" description="This page could not be found.">
  <section class="container" style="padding:clamp(4rem,10vw,8rem) 0">
    <p class="eyebrow">404</p>
    <h1>This page doesn’t exist.</h1>
    <p style="max-width:36rem;font-size:1.125rem">The link may be old or mistyped. Here is where you can go next.</p>
    <div class="button-row">
      <a class="button" href="/">Back to home</a>
      <a class="button button--secondary" href="/work/estimates">See selected work</a>
    </div>
  </section>
</BaseLayout>

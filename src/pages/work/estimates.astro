const newPrototype = 'https://www.figma.com/proto/edpFxVc5O79LOaxaQ0CVYD/Portfolio-example?node-id=153-16&t=uVO84YdTIGZINfiH-1&scaling=scale-down&content-scaling=fixed&page-id=140%3A15&starting-point-node-id=153%3A16&show-proto-sidebar=1';
const oldPrototypeEmbed = 'https://embed.figma.com/proto/edpFxVc5O79LOaxaQ0CVYD/Portfolio-example?node-id=475-89&t=LEnq6ovECzX0pgZP-1&scaling=scale-down&content-scaling=fixed&page-id=0%3A1&starting-point-node-id=475%3A89&embed-host=share';

const newPrototype = 'https://www.figma.com/proto/edpFxVc5O79LOaxaQ0CVYD/Portfolio-example?node-id=759-366&p=f&t=J4vGUZM1KvcQSLfh-1&scaling=min-zoom&content-scaling=fixed&page-id=741%3A216&starting-point-node-id=759%3A366';
const newPrototypeEmbed = 'https://embed.figma.com/proto/edpFxVc5O79LOaxaQ0CVYD/Portfolio-example?node-id=759-366&p=f&t=J4vGUZM1KvcQSLfh-1&scaling=min-zoom&content-scaling=fixed&page-id=741%3A216&starting-point-node-id=759%3A366&embed-host=share';
---
<BaseLayout title="Medical claim redesign — Dana" description="A guided, responsive, and accessible medical claim experience for Canada Life plan members.">
  <header class="case-hero"><div class="container"><a class="back" href="/#work">← Selected work</a><p class="eyebrow">Canada Life · Released product</p><h1>Redesigning the post-visit medical claim experience</h1><p class="lead">A guided, responsive, and accessible reimbursement flow for plan members submitting medical expenses and supporting documents.</p></div></header>

  <section class="tldr" aria-label="Project summary"><div class="container"><p class="eyebrow">At a glance</p><ul class="tldr-list"><li><b>Problem</b><span>The claim form on the legacy platform was long, desktop-first, and hard to finish on a phone.</span></li><li><b>What I did</b><span>During the migration to Salesforce Industries, I redesigned it as a guided, step-by-step journey and refined it through two rounds of usability testing with plan members.</span></li><li><b>Result</b><span>Completion was 30% faster in usability testing, and the experience shipped at WCAG AA.</span></li></ul></div></section>

  <section class="snapshot"><div class="container grid"><div><p class="eyebrow">Project snapshot</p><h2>Modernizing a high-use benefits journey</h2><p>I redesigned the claim experience during the migration from SAP Hybris to Salesforce Industries. It had to simplify submission while supporting benefit rules, responsive layouts, technical constraints, and accessibility requirements.</p></div><dl><div><dt>My role</dt><dd>UX Designer, end-to-end product experience</dd></div><div><dt>Users</dt><dd>Group-benefits members requesting reimbursement after receiving care</dd></div><div><dt>Platforms</dt><dd>Responsive web and mobile</dd></div><div><dt>Partners</dt><dd>Product, research, content, accessibility, QA, and engineering</dd></div><div><dt>Status</dt><dd>Released on a platform used by 10M+ members</dd></div></dl></div></section>

  <section><div class="container narrow"><p class="eyebrow">The problem</p><h2>Filing a claim was long, inconsistent, and hard on mobile</h2><p class="large">After paying for an eligible medical service, members had to provide practitioner details, expense information, and supporting documents to get reimbursed. The original experience left them unsure what was required and whether they had finished.</p><div class="challenge"><strong>Design challenge</strong><p>How might we create a clearer claim journey while supporting multiple claim types, platform migration, responsive behavior, and accessibility requirements?</p></div></div></section>

  <section class="legacy"><div class="container"><div class="section-head"><p class="eyebrow">Previous experience · SAP Hybris</p><h2>The legacy journey exposed complexity at every stage</h2><p>These annotated wireframes document the experience before the migration: claim-type decisions, eligibility questions, expense fields, document uploads, and a final review.</p></div><aside class="legacy-summary"><strong>What the review revealed</strong><p>The journey contained at least 12 annotated actions from sign-in to submission. Long forms and instructions competed for attention, and the desktop-first layout made the task harder on smaller screens.</p></aside><div class="legacy-gallery"><figure><a href="/images/medical-claims/legacy/old-01-entry.png" target="_blank" rel="noreferrer"><img src="/images/medical-claims/legacy/old-01-entry.png" alt="Legacy Hybris claim landing page with the Start online claim action annotated" loading="lazy"/></a><figcaption><b>01 · Entry point</b><span>Members began from a separate claim landing page.</span></figcaption></figure><figure><a href="/images/medical-claims/legacy/old-02-claim-type.png" target="_blank" rel="noreferrer"><img src="/images/medical-claims/legacy/old-02-claim-type.png" alt="Legacy Hybris page asking members to select a claim type" loading="lazy"/></a><figcaption><b>02 · Claim type</b><span>The flow branched early based on the expense category.</span></figcaption></figure><figure><a href="/images/medical-claims/legacy/old-03-questions.png" target="_blank" rel="noreferrer"><img src="/images/medical-claims/legacy/old-03-questions.png" alt="Legacy Hybris form containing a dense set of eligibility questions" loading="lazy"/></a><figcaption><b>03 · Eligibility questions</b><span>Several decisions appeared together in one dense form.</span></figcaption></figure><figure><a href="/images/medical-claims/legacy/old-04-expense-details.png" target="_blank" rel="noreferrer"><img src="/images/medical-claims/legacy/old-04-expense-details.png" alt="Legacy Hybris form for receipt and expense details" loading="lazy"/></a><figcaption><b>04 · Expense details</b><span>Receipt information required another detailed form.</span></figcaption></figure><figure><a href="/images/medical-claims/legacy/old-05-documents.png" target="_blank" rel="noreferrer"><img src="/images/medical-claims/legacy/old-05-documents.png" alt="Legacy Hybris document upload page with supporting information" loading="lazy"/></a><figcaption><b>05 · Supporting documents</b><span>Upload guidance and file actions shared the same screen.</span></figcaption></figure><figure><a href="/images/medical-claims/legacy/old-06-review.png" target="_blank" rel="noreferrer"><img src="/images/medical-claims/legacy/old-06-review.png" alt="Legacy Hybris confirmation page shown before claim submission" loading="lazy"/></a><figcaption><b>06 · Review and submit</b><span>Members reviewed the accumulated information before submitting.</span></figcaption></figure></div><p class="artifact-note">Select any wireframe to view it at full size. Screens use sample account data.</p></div></section>

  <section class="tinted"><div class="container grid evidence"><div><p class="eyebrow">Research and validation</p><h2>Testing the structure before refining the interface</h2><p>Two rounds of usability testing with plan members: wireframes first, to test flow structure and comprehension, then high-fidelity prototypes, to test readability, hierarchy, and accessibility.</p></div><div class="evidence-list"><article><b>Round 1</b><h3>Wireframe validation</h3><p>Tested whether the sequence and grouping of questions made sense before visual refinement.</p></article><article><b>Round 2</b><h3>High-fidelity validation</h3><p>Tested visual hierarchy, upload guidance, and how confident members felt completing a claim.</p></article><article><b>Refinements</b><h3>What changed</h3><p>Feedback informed content hierarchy, button language, and instructions for supporting documents.</p></article></div></div></section>

  <section><div class="container"><p class="eyebrow">Design decisions</p><h2>Three decisions shaped the experience</h2><div class="decisions"><article><span>01</span><h3>Turn a dense form into a guided journey</h3><p>The flow focused members on one group of related information at a time, replacing long forms with a step-by-step structure.</p></article><article><span>02</span><h3>Explain documents at the point of need</h3><p>Receipt and supporting-document guidance appeared near the relevant action, with upload instructions refined through testing.</p></article><article><span>03</span><h3>Prevent errors before submission</h3><p>Real-time validation, clear required fields, focus behavior, and confirmation states helped members resolve issues earlier.</p></article></div></div></section>

  <section class="platform-walkthrough"><div class="container"><div class="section-head"><p class="eyebrow">Interactive prototype · Salesforce</p><h2>Explore the redesigned claim journey</h2><p>The Hybris platform was being retired and end-user access was limited, so I worked with developers who still had access to document the legacy journey. That baseline informed the redesigned Salesforce experience below, from entry and claim-type selection to supporting documents.</p></div><article class="interactive-prototype"><div class="prototype-label"><div><span>Redesigned experience</span><h3>Medical-claim walkthrough</h3></div><a href={newPrototype} target="_blank" rel="noreferrer">Open in Figma ↗</a></div><div class="figma-frame"><iframe src={newPrototypeEmbed} title="Interactive walkthrough of the redesigned Salesforce medical-claim flow" loading="lazy" allowfullscreen></iframe></div><p>Follow the end-to-end path through the guided structure, recovery paths, and supporting-document experience.</p></article><p class="embed-note">If the prototype does not load in the page, use “Open in Figma” to launch it in a separate tab.</p></div></section>

  <section class="prototype"><div class="container"><div class="section-head"><p class="eyebrow">Shipped product</p><h2>See the complete claim journey in motion</h2><p>Recordings of the released Salesforce experience on desktop and mobile.</p></div><div class="videos"><article><div class="video-frame"><iframe src="https://www.youtube-nocookie.com/embed/wBS1dzmDpI0" title="Released medical-claim experience, website walkthrough" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div><h3>Website walkthrough</h3><p>Follow a complete test claim through the released desktop experience.</p></article><article><div class="video-frame"><iframe src="https://www.youtube-nocookie.com/embed/KUC6sUW_B6c" title="Released medical-claim experience, mobile responsive walkthrough" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div><h3>Mobile responsive walkthrough</h3><p>See how the same journey adapts to a narrow viewport.</p></article></div></div></section>

  <section><div class="container grid responsive"><div><p class="eyebrow">Responsive experience</p><h2>Designed for how members actually file claims</h2><p>Members often submit from home or on a phone, with receipts in hand. Reviewing both viewports showed more than layout differences: controls had to stay reachable, headings had to wrap predictably, and long upload and privacy content needed a usable reading order.</p><p>The released experience keeps the same information hierarchy and direct path into the claim journey on every screen size.</p></div><img src="/images/medical-claims/released-flow/06-mobile-entry.webp" alt="Released Canada Life Make a claim entry page in a mobile viewport" loading="lazy"/></div></section>


  <section><div class="container"><p class="eyebrow">Experience model</p><h2>Five steps from preparation to confirmation</h2><ol class="flow"><li><b>1</b><strong>Prepare</strong><small>Understand required information</small></li><li><b>2</b><strong>Describe</strong><small>Enter provider and expense details</small></li><li><b>3</b><strong>Document</strong><small>Add receipts and supporting files</small></li><li><b>4</b><strong>Review</strong><small>Confirm information</small></li><li><b>5</b><strong>Submit</strong><small>Receive next steps</small></li></ol></div></section>

  <section class="impact"><div class="container"><div class="section-head"><p class="eyebrow">Outcome</p><h2>Faster in testing, accessible at launch</h2></div><div class="impact-grid"><article><strong>30%</strong><p>faster average completion in usability testing</p></article><article><strong>WCAG AA</strong><p>accessibility level reported at launch</p></article><article><strong>Released</strong><p>to production in the group-insurance portal</p></article></div><p class="caveat">The 30% figure comes from usability testing, not production analytics.</p></div></section>

  <section class="dark"><div class="container grid"><div><p class="eyebrow">Accessibility and delivery</p><h2>Designed through implementation—not only handoff</h2></div><div><p>I worked with engineering through design reviews, and with accessibility, QA, content, and product partners as the experience moved toward release.</p><p>The work covered clear labels, understandable validation, contrast, keyboard and focus behavior, readable hierarchy, and mobile-friendly spacing. WCAG fixes and usability refinements continued after launch.</p></div></div></section>

  <section><div class="container narrow"><p class="eyebrow">Reflection</p><h2>Simplifying means deciding when members meet complexity</h2><p class="large">Simplifying a claim doesn’t remove the benefit rules behind it. I decided when members encounter them, explained them at the point of need, and worked with engineering so the design held up in the released product.</p><div class="button-row"><a class="button" href="/work/estimates/">Next: pre-treatment estimates</a><a class="button button--secondary" href="/#work">Back to selected work</a></div></div></section>


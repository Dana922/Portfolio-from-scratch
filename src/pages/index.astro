---
import BaseLayout from '../layouts/BaseLayout.astro'; import ProjectCard from '../components/ProjectCard.astro';
---
<BaseLayout title="Dana — Product Designer" description="Product designer simplifying complex healthcare, insurance, and accessibility experiences.">
<section class="hero" aria-labelledby="hero-title"><div class="container hero-grid"><div><p class="eyebrow">Product designer · Healthcare · Accessibility</p><h1 id="hero-title">Making complex systems feel clear and human.</h1><p class="summary">Hi, I’m Dana, a product designer with 5+ years of experience in healthcare, insurance, and enterprise products. I research, design, and ship accessible experiences for high-stakes services.</p><div class="button-row"><a class="button" href="#work">View selected work</a><a class="button button--secondary" href="#about">About me</a></div></div><aside class="proof" aria-label="Professional highlights"><p>Released enterprise healthcare work and B2B product discovery.</p><dl><div><dt>10M+</dt><dd>members on the Canada Life platform where my work shipped</dd></div><div><dt>5+ years</dt><dd>in UX and product design</dd></div><div><dt>Current focus</dt><dd>accessibility, creative AI, and front-end prototyping</dd></div></dl></aside></div></section>
<section class="work" id="work" aria-labelledby="work-title"><div class="container"><div class="section-heading"><p class="eyebrow">Selected work</p><h2 id="work-title">Two shipped Canada Life projects and one discovery project.</h2><p>Each case study covers the problem, my role, the evidence behind my decisions, and the result.</p></div><div class="projects"><ProjectCard number="01" organization="Canada Life" title="Making pre-treatment estimates easier to find and track" image="/images/estimates/mobile-entry.webp" resultValue="7 → 4" resultLabel="steps in the primary journey" summary="A hidden service became a dedicated path, designed from 24,177 recorded submissions, a 25-person tree test, and 1,476 survey comments." meta={['Lead UX','Research synthesis','Information architecture','Released']} tone="blue" href="/work/estimates/"/><ProjectCard number="02" organization="Canada Life" title="Redesigning the post-visit medical claim experience" image="/images/medical-claims/case-study-cover.webp" resultValue="30%" resultLabel="faster completion in usability testing" summary="A guided claim journey for plan members submitting expenses and receipts, shipped at WCAG AA during the move to Salesforce." meta={['End-to-end UX','Responsive web','Accessibility','Released']} tone="navy" href="/work/medical-claims/"/><ProjectCard number="03" organization="Dialogue" title="Designing a clearer account-management portal" image="/images/dialogue/card-cover.webp" resultValue="Discovery" resultLabel="interviews to two prototype stages" summary="An interview-led concept that separates internal operations from customer self-service." meta={['Product design','User interviews','Information architecture','Discovery']} tone="teal" href="/work/dialogue-account-management/"/></div></div></section>
<section class="placeholder-section" id="about" aria-labelledby="about-title"><div class="container about-teaser"><div><p class="eyebrow">About</p><h2 id="about-title">Evidence first, accessible by design.</h2></div><div><p>I work in regulated healthcare and insurance, where I pair research and analytics with close collaboration across engineering, accessibility, and QA so designs ship as intended.</p><a class="text-link" href="/about/">More about me and how I work <span aria-hidden="true">→</span></a></div></div></section>
<style>.hero{display:grid;min-height:min(48rem,calc(100vh - 5rem));align-items:center;padding:clamp(5rem,12vw,10rem) 0;background:radial-gradient(circle at 84% 18%,rgba(36,88,198,.12),transparent 28rem),linear-gradient(180deg,#fff,#f8faff)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(18rem,.7fr);align-items:end;gap:clamp(3rem,8vw,8rem)}.summary{max-width:39rem;margin-bottom:2rem;font-size:clamp(1.125rem,2.3vw,1.4rem);line-height:1.55}.proof{padding:clamp(1.5rem,3vw,2.25rem);border:1px solid rgba(36,88,198,.16);border-radius:1.4rem;background:rgba(255,255,255,.78);box-shadow:0 1.25rem 4rem rgba(21,36,59,.08)}.proof>p{margin-bottom:1.5rem;color:var(--color-ink);font-weight:650}dl{margin:0}dl div{padding:1.15rem 0;border-top:1px solid var(--color-border)}dt{margin-bottom:.2rem;color:var(--color-ink);font-size:1.25rem;font-weight:750}dd{margin:0;color:var(--color-muted);font-size:.9rem;line-height:1.5}.work{padding:clamp(5rem,11vw,10rem) 0}.projects{display:grid;gap:clamp(1.5rem,4vw,3rem)}.about-teaser{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem)}.about-teaser p{font-size:1.15rem}.text-link{font-weight:750}@media(max-width:52rem){.hero-grid,.about-teaser{grid-template-columns:1fr;align-items:start}.proof{max-width:35rem}}</style>
</BaseLayout>

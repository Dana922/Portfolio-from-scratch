---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dana — Product Designer"
  description="Product designer simplifying complex healthcare, insurance, and accessibility experiences."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <p class="eyebrow">Product designer</p>
      <h1 id="hero-title">Simplifying complex, high-stakes experiences.</h1>
      <p class="hero-summary">
        I design thoughtful, accessible digital products across healthcare,
        insurance, and emerging AI experiences.
      </p>
      <div class="button-row">
        <a class="button" href="#work">View selected work</a>
        <a class="button button--secondary" href="#about">About me</a>
      </div>
    </div>
  </section>

  <section class="placeholder-section" id="work" aria-labelledby="work-title">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">Case studies are the next build step.</h2>
      <p>
        This section will feature the medical claim redesign, pre-treatment
        estimates, and Dialogue account-management portal.
      </p>
    </div>
  </section>

  <section class="placeholder-section" id="about" aria-labelledby="about-title">
    <div class="container">
      <p class="eyebrow">About</p>
      <h2 id="about-title">Design grounded in empathy, systems, and evidence.</h2>
      <p>
        The complete professional biography and capabilities will be added after
        the project stories establish the portfolio's main narrative.
      </p>
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      min-height: min(48rem, calc(100vh - 5rem));
      align-items: center;
      padding: clamp(5rem, 12vw, 10rem) 0;
      background:
        radial-gradient(circle at 84% 18%, rgba(36, 88, 198, 0.12), transparent 28rem),
        linear-gradient(180deg, #fff 0%, #f8faff 100%);
    }

    .hero-summary {
      max-width: 39rem;
      margin-bottom: 2rem;
      color: var(--color-text);
      font-size: clamp(1.125rem, 2.3vw, 1.4rem);
      line-height: 1.55;
    }
  </style>
</BaseLayout>

---
interface Props { number: string; title: string; summary: string; organization: string; meta: string[]; tone: string; href?: string; }
const { number, title, summary, organization, meta, tone, href: suppliedHref } = Astro.props;
const href = suppliedHref ?? (number === '01' ? '/work/medical-claims/' : undefined);
---
<article class={`card ${tone}`}><div class="visual" aria-hidden="true"><span>{number}</span><strong>{organization}</strong></div><div class="content"><p class="org">{organization}</p><h3>{title}</h3><p>{summary}</p><ul aria-label="Project details">{meta.map((item) => <li>{item}</li>)}</ul>{href ? <a class="case-link" href={href}>Read case study <span aria-hidden="true">→</span></a> : <p class="status">Full case study coming next</p>}</div></article>
<style>
.card{display:grid;grid-template-columns:minmax(17rem,.9fr) minmax(19rem,1.1fr);overflow:hidden;border:1px solid var(--color-border);border-radius:1.4rem;background:#fff;box-shadow:0 1.25rem 4rem rgba(21,36,59,.08)}.visual{position:relative;display:flex;min-height:25rem;flex-direction:column;justify-content:space-between;overflow:hidden;padding:clamp(1.5rem,4vw,2.5rem);color:#fff}.visual:after{position:absolute;width:24rem;height:24rem;right:-11rem;bottom:-9rem;border:1px solid rgba(255,255,255,.3);border-radius:50%;content:''}.visual span{font-size:.875rem;font-weight:750;letter-spacing:.12em}.visual strong{z-index:1;max-width:8ch;font-size:clamp(2.4rem,5vw,4.5rem);line-height:.94;letter-spacing:-.055em}.navy .visual{background:linear-gradient(145deg,#10213a,#294c7c)}.blue .visual{background:linear-gradient(145deg,#174aa5,#3979d7)}.teal .visual{background:linear-gradient(145deg,#0f4d59,#247d86)}.content{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,5vw,4.25rem)}.org{margin-bottom:.85rem;color:var(--color-accent);font-size:.8rem;font-weight:750;letter-spacing:.09em;text-transform:uppercase}h3{margin-bottom:1rem;font-size:clamp(1.75rem,3.6vw,2.8rem)}.content>p:not(.org,.status){max-width:37rem;margin-bottom:1.5rem;font-size:1.05rem}ul{display:flex;flex-wrap:wrap;margin:0 0 1.75rem;padding:0;gap:.5rem;list-style:none}li{padding:.38rem .65rem;border:1px solid var(--color-border);border-radius:999px;color:var(--color-muted);font-size:.78rem;font-weight:650}.status{margin:0;color:var(--color-ink);font-size:.9rem;font-weight:700}@media(max-width:48rem){.card{grid-template-columns:1fr}.visual{min-height:18rem}}
.case-link{width:max-content;color:var(--color-ink);font-weight:750;text-decoration-thickness:.12rem}.case-link:hover{color:var(--color-accent)}</style>
